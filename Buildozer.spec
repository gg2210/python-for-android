[app]

# Nome do seu aplicativo
title = Meu Jogo PyGame

# Nome do pacote (deve ser único)
package.name = meujogo

# Domínio do pacote (seu domínio reverso)
package.domain = com.seudominio

# Código fonte principal
source.dir = .

# Arquivo principal
source.main = main.py

# Versões
version = 1.0

# Requirements (dependências)
requirements = python3, pygame, kivy

# Permissões (se necessário)
android.permissions = INTERNET

# Orientação da tela
orientation = landscape

# Versão do Android
android.api = 29
android.minapi = 21
android.ndk = 21e

# Configurações de ícone (se tiver)
# icon.filename = %(source.dir)s/assets/icon.png
